{
  "manifest_version": 3,
  "name": "Huntdeck",
  "version": "1.1.1",
  "description": "One click for every application. Track your job hunt privately, on your device.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Huntdeck \u2014 application tracker",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  },
  "commands": {
    "log-application": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Log an application (enable in Huntdeck Settings)"
    }
  }
}
